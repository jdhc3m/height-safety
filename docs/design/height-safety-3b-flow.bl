t("North roof, grid A-1 · Open",Inter,11) p(930,648) f[(#5D6B7A)] "ExpectedLocation"
t("Capture evidence  →",Inter,12,sb) p(930,668) f[(#2E5AAC)] "ExpectedAction"

fr p(1202,312) s(270,840) f[(#FFFFFF)] rd(24) st[(#D7E0EA,w(1))] "AnchorCapture"
t("⌁  Anchor capture",Inter,20,b) p(1226,354) f[(#102235)] "AnchorCaptureTitle"
t("A-001 · North roof, grid A-1",Inter,12) p(1226,386) f[(#5D6B7A)] "AnchorHeader"
fr p(1226,418) s(222,38) f[(#E2EAFE)] rd(12) "SelectedAnchor"
t("Selected register anchor · NSW",Inter,11,sb) p(1238,431) f[(#2E5AAC)] "SelectedAnchorText"
t("Register reconciliation",Inter,12,sb) p(1226,484) f[(#102235)] "ReconcileLabel"
t("Expected · New · Replacement · Duplicate",Inter,11) p(1226,506) f[(#5D6B7A)] "ReconcileChoices"
t("Recorded outcome",Inter,12,sb) p(1226,548) f[(#102235)] "OutcomeLabel"
fr p(1226,568) s(104,34) f[(#E2F3EA)] rd(12) "Serviceable"
t("Serviceable",Inter,11,sb) p(1238,579) f[(#17633A)] "ServiceableText"
fr p(1344,568) s(104,34) f[(#F2F5FA)] rd(12) "Defective"
t("Defective",Inter,11,sb) p(1358,579) f[(#102235)] "DefectiveText"
fr p(1226,610) s(104,34) f[(#F2F5FA)] rd(12) "NotInspected"
t("Not inspected",Inter,10,sb) p(1236,621) f[(#102235)] "NotInspectedText"
fr p(1344,610) s(104,34) f[(#F2F5FA)] rd(12) "Further"
t("Further assess",Inter,10,sb) p(1354,621) f[(#102235)] "FurtherText"
t("If not inspected: exception reason",Inter,11,sb) p(1226,674) f[(#102235)] "ExceptionLabel"
t("Inaccessible · Unable to locate",Inter,11) p(1226,696) f[(#5D6B7A)] "ExceptionChoices"
t("Identity/location confirmation · disposition",Inter,11) p(1226,742) f[(#102235)] "ConfirmationLabel"
t("Observations · conditional detail · proof-test",Inter,11) p(1226,764) f[(#5D6B7A)] "DetailChoices"
fr p(1226,804) s(222,52) f[(#F2F5FA)] rd(14) "Photo"
t("▣  Photos · associated to A-001",Inter,11,sb) p(1238,824) f[(#102235)] "PhotoText"
fr p(1226,872) s(222,50) f[(#2E5AAC)] rd(25) "Save"
t("✓  Save locally",Inter,12,sb) p(1290,888) f[(#FFFFFF)] "SaveText"
t("Local draft state stays visible",Inter,11) p(1226,956) f[(#815800)] "LocalState"

line(from(#Pack),to(#AnchorCapture)) intent(flow)
t("No separate anchor-register or evidence route",Inter,13) p(890,1000) f[(#102235)] "CaptureBoundary"
t("2B relationship guardrail: outcome ≠ compliance · jurisdiction ≠ legal rule",Inter,13) p(890,1032) f[(#5D6B7A)] "CaptureGuardrail"
t("Icons: anchor · camera · lock · warning · local save",Inter,13) p(890,1064) f[(#5D6B7A)] "CaptureIcons"

fr p(1628,150) s(700,1400) f[(#F8FAFC)] rd(28) "NextSlice"
t("NEXT SLICE · FUTURE",Inter,14,sb) p(1668,190) f[(#2E5AAC)] "FutureKicker"
t("Review and sync direction",Inter,28,b) p(1668,220) f[(#102235)] "FutureTitle"
t("Visible here for validation only · not built in current app",Inter,15) p(1668,260) f[(#5D6B7A)] "FutureNote"

fr p(1668,312) s(270,330) f[(#FFFFFF)] rd(24) st[(#D7E0EA,w(1))] "Review"
t("◉  Review & submission",Inter,19,b) p(1692,354) f[(#102235)] "ReviewTitle"
fr p(1692,392) s(156,30) f[(#FFF0D6)] rd(15) "FutureChip"
t("FUTURE SLICE",Inter,10,sb) p(1710,402) f[(#815800)] "FutureChipText"
t("Coverage · field issues · photo state",Inter,12) p(1692,456) f[(#5D6B7A)] "ReviewLine1"
t("Conflict visibility · requested changes",Inter,12) p(1692,482) f[(#5D6B7A)] "ReviewLine2"
t("Recorded revision only; no certification claim",Inter,12) p(1692,524) f[(#102235)] "ReviewGuardrail"

fr p(1960,312) s(270,330) f[(#FFFFFF)] rd(24) st[(#D7E0EA,w(1))] "Sync"
t("☁  Sync states",Inter,19,b) p(1984,354) f[(#102235)] "SyncTitle"
fr p(1984,392) s(118,30) f[(#E2EAFE)] rd(15) "LocalChip"
