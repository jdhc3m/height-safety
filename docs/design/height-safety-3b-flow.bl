bp:v1
canvas:
  backgroundEnabled: true
  backgroundColor: "#EEF2F6"
---
fr p(0,0) s(2400,1680) f[(#EEF2F6)] "Board"
t("HEIGHT SAFETY · 3B UI ALIGNMENT",Inter,28,b) p(72,48) f[(#102235)] "BoardTitle"
t("Stage 2B source · current Android screens · owner validation",Inter,16) p(74,88) f[(#5D6B7A)] "BoardSubtitle"

fr p(72,150) s(700,1400) f[(#F8FAFC)] rd(28) "BuiltBaseline"
t("BUILT BASELINE",Inter,14,sb) p(112,190) f[(#2E5AAC)] "BaselineKicker"
t("Start with real app surfaces",Inter,28,b) p(112,220) f[(#102235)] "BaselineTitle"
t("Sign in → authorised jobs → versioned job pack",Inter,15) p(112,260) f[(#5D6B7A)] "BaselineNote"

fr p(112,312) s(270,520) f[(#FFFFFF)] rd(24) st[(#D7E0EA,w(1))] "SignIn"
t("◈  Height Safety",Inter,21,b) p(136,354) f[(#102235)] "SignInBrand"
t("Inspector sign-in",Inter,16) p(136,392) f[(#5D6B7A)] "SignInSub"
fr p(136,438) s(222,58) f[(#F8FAFC)] rd(12) st[(#9BAABA,w(1))] "CompanyId"
t("Company ID",Inter,14) p(152,458) f[(#5D6B7A)] "CompanyIdText"
fr p(136,520) s(222,54) f[(#2E5AAC)] rd(27) "SignInButton"
t("Sign in  →",Inter,15,sb) p(202,538) f[(#FFFFFF)] "SignInButtonText"
t("Provider-neutral entry",Inter,12) p(136,604) f[(#5D6B7A)] "SignInNote"

fr p(424,312) s(270,520) f[(#FFFFFF)] rd(24) st[(#D7E0EA,w(1))] "Jobs"
t("▣  Inspector jobs",Inter,20,b) p(448,354) f[(#102235)] "JobsTitle"
t("debug.inspector@example.test",Inter,12) p(448,386) f[(#5D6B7A)] "JobsAccount"
fr p(448,420) s(222,54) f[(#E2F3EA)] rd(14) "JobsBanner"
t("✓  Jobs updated",Inter,13,sb) p(464,440) f[(#17633A)] "JobsBannerText"
fr p(448,496) s(222,142) f[(#F2F5FA)] rd(16) "JobCard"
t("DEMO-NSW-001",Inter,16,b) p(464,520) f[(#102235)] "JobRef"
t("NSW · Assigned",Inter,12,sb) p(464,548) f[(#2E5AAC)] "JobStatus"
t("Pack version 1",Inter,12) p(464,574) f[(#5D6B7A)] "JobPack"
t("Open job pack  →",Inter,13,sb) p(464,612) f[(#2E5AAC)] "JobAction"

line(from(#SignIn),to(#Jobs)) intent(flow)
t("States kept in same surface: loading · empty · error · session expired",Inter,13) p(112,900) f[(#102235)] "BaselineStates"
t("Metadata stays visible: job ref · jurisdiction · status · assignment · pack version · planned date",Inter,13) p(112,932) f[(#5D6B7A)] "BaselineMeta"
t("Icon direction: work · location · pack · person · calendar · sync",Inter,13) p(112,964) f[(#5D6B7A)] "BaselineIcons"

fr p(850,150) s(700,1400) f[(#F8FAFC)] rd(28) "CurrentCapture"
t("3B-03 CURRENT",Inter,14,sb) p(890,190) f[(#2E5AAC)] "CaptureKicker"
t("Context first, capture second",Inter,28,b) p(890,220) f[(#102235)] "CaptureTitle"
t("Job pack owns expected anchors; capture owns one selected anchor",Inter,15) p(890,260) f[(#5D6B7A)] "CaptureNote"

fr p(890,312) s(270,400) f[(#FFFFFF)] rd(24) st[(#D7E0EA,w(1))] "Pack"
t("▣  Job pack",Inter,20,b) p(914,354) f[(#102235)] "PackTitle"
t("DEMO-NSW-001",Inter,13) p(914,386) f[(#5D6B7A)] "PackRef"
fr p(914,420) s(100,32) f[(#E2EAFE)] rd(16) "Jurisdiction"
t("NSW",Inter,12,sb) p(948,430) f[(#2E5AAC)] "JurisdictionText"
t("Synthetic NSW roof site",Inter,13) p(914,480) f[(#102235)] "Site"
t("Pack v1 · Available offline",Inter,12) p(914,510) f[(#815800)] "PackState"
t("Address: 1 Debug Street",Inter,12) p(914,538) f[(#5D6B7A)] "Address"
